flowchart LR
    subgraph AdminTrigger["관리자 트리거"]
        Admin["Admin Web<br/>(Next.js)"]
        Directus["Directus<br/>(콘텐츠 변경 hook)"]
    end

    subgraph APIQueue["enqueue"]
        API2["backend/api<br/>POST /jobs/tts"]
