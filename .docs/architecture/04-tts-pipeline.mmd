        W4["db_update<br/>(audio_urls)"]
    end

    subgraph Providers["TTS Providers"]
        Az["Azure Speech<br/>en-US/en-GB/en-AU"]
        Pl["AWS Polly<br/>fallback"]
        Pi["Piper<br/>(self-host, dev/staging)"]
    end

    subgraph Store["스토리지"]
        S32["S3 / R2<br/>(prod)"]
        Min["MinIO<br/>(local)"]
