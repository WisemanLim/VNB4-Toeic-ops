# ============================================================================
# .env.prod — production secrets/config
# 사용:
#   cp .env.prod.example .env.prod   # 이후 모든 __SECRET__ / __STRONG_*__ 교체
#
# 기본 가정: docker-compose.prod.yml 의 self-hosted Postgres 사용.
# 외부 관리형 DB (RDS/Supabase/Neon) 쓰려면 .env.prod.managed.example 참조.
# ============================================================================
ENV=prod

# ---------------------------------------------------------------------------
# Database — self-hosted Postgres (default)
# ---------------------------------------------------------------------------
# postgres 컨테이너 초기화 변수. 첫 부팅에만 사용됨.
POSTGRES_DB=toeic_prod
POSTGRES_USER=toeic
POSTGRES_PASSWORD=__STRONG_DB_PASSWORD__

# Prisma 및 NestJS 가 사용하는 연결 URL.
# 컨테이너 네트워크 내부에서는 호스트가 'postgres' (compose service name).
# 호스트 머신/마이그레이션 스크립트에서 직접 접근하려면 localhost:5432 로 포트 매핑 추가 필요.
DATABASE_URL=postgres://toeic:__STRONG_DB_PASSWORD__@postgres:5432/toeic_prod?schema=public

# ---------------------------------------------------------------------------
# Cache / Queue — Valkey (BSD-3, Redis 7.2 호환)
# ---------------------------------------------------------------------------
REDIS_HOST=valkey
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2 (egress 0) 또는 AWS S3 권장
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=toeic-media-prod
S3_ACCESS_KEY=__SECRET__
S3_SECRET_KEY=__SECRET__
S3_PUBLIC_BASE=https://media.example.com

# ---------------------------------------------------------------------------
# TTS — Azure Neural primary, AWS Polly backup
# ---------------------------------------------------------------------------
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=__SECRET__
AZURE_SPEECH_REGION=koreacentral
AWS_ACCESS_KEY_ID=__SECRET__
AWS_SECRET_ACCESS_KEY=__SECRET__

# ---------------------------------------------------------------------------
# Auth — JWT + OAuth
# ---------------------------------------------------------------------------
JWT_SECRET=__STRONG_JWT_SECRET_64CHARS__
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=__SECRET__
GOOGLE_CLIENT_SECRET=__SECRET__
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback
APPLE_CLIENT_ID=__SECRET__
KAKAO_CLIENT_ID=__SECRET__

# ---------------------------------------------------------------------------
# Default admin — backend ensures this account on boot (create-if-absent, role=admin).
# 운영 콘솔 최초 로그인용. 반드시 강력한 비밀번호로 교체할 것.
# 부트스트랩을 끄려면 SEED_ADMIN_PASSWORD 를 비워 둔다.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=__SECRET__

# ---------------------------------------------------------------------------
# Compose image tag pinning (선택)
# ---------------------------------------------------------------------------
# REGISTRY=ghcr.io/your-org
# TAG=v1.0.0
