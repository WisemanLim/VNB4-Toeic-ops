ENV=local

# DB (matches docker-compose.local.yml)
DATABASE_URL=postgres://toeic:toeic@localhost:5432/toeic_local

# Cache/queue (Valkey on default port)
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toeic-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE=http://localhost:9000/toeic-media

# TTS
TTS_PROVIDER=piper       # use Piper OSS in dev (zero-cost); set 'azure' for real voices
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
PIPER_URL=http://localhost:5000/synthesize

# Auth
JWT_SECRET=local-dev-secret-replace-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Default admin — backend ensures this account on boot (create-if-absent, role=admin).
# Used to sign in to the admin console (frontend) for words/lessons/sentences/TTS/users.
# Leave SEED_ADMIN_PASSWORD empty to skip bootstrap.
SEED_ADMIN_EMAIL=admin@vnb4.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=관리자

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Observability
SENTRY_DSN=
