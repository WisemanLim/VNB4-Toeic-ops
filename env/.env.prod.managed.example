# ============================================================================
# .env.prod.managed.example — 외부 관리형 Postgres (RDS / Supabase / Neon /
# Cloud SQL / Aiven 등) 사용 시 템플릿.
#
# 사용:
#   cp .env.prod.managed.example .env.prod   # 그 후 모든 __SECRET__ 교체
#   → docker-compose.prod.yml 의 postgres 서비스 블록을 주석 처리
#     (또는 `docker compose --profile no-db ...` 식으로 운영 시점 제외)
#
# pgvector 등 확장은 관리형 콘솔에서 사전 설치 필요:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
#   CREATE EXTENSION IF NOT EXISTS unaccent;
# (Supabase/Neon 는 vector 기본 지원. RDS 는 parameter group 에서 enable)
# ============================================================================
ENV=prod

# ---------------------------------------------------------------------------
# Database — 외부 관리형
# ---------------------------------------------------------------------------
# 관리형 호스트로 직접 가리킴. self-host 가 아니므로 POSTGRES_* 초기화 변수는 불필요.
# sslmode=require 또는 verify-full 권장.
DATABASE_URL=postgres://USER:PASS@db.example-region.rds.amazonaws.com:5432/toeic_prod?sslmode=require

# Supabase 예:
# DATABASE_URL=postgres://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true

# Neon 예:
# DATABASE_URL=postgres://USER:PASS@ep-XXXX.us-east-2.aws.neon.tech/toeic_prod?sslmode=require

# ---------------------------------------------------------------------------
# Cache / Queue
# ---------------------------------------------------------------------------
REDIS_HOST=valkey
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=toeic-media-prod
S3_ACCESS_KEY=__SECRET__
S3_SECRET_KEY=__SECRET__
S3_PUBLIC_BASE=https://media.example.com

# ---------------------------------------------------------------------------
# TTS
# ---------------------------------------------------------------------------
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=__SECRET__
AZURE_SPEECH_REGION=koreacentral
AWS_ACCESS_KEY_ID=__SECRET__
AWS_SECRET_ACCESS_KEY=__SECRET__

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=__STRONG_JWT_SECRET_64CHARS__
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=__SECRET__
GOOGLE_CLIENT_SECRET=__SECRET__
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback
APPLE_CLIENT_ID=__SECRET__
KAKAO_CLIENT_ID=__SECRET__

# ---------------------------------------------------------------------------
# Default admin — backend ensures this account on boot (create-if-absent, role=admin).
# 운영 콘솔 최초 로그인용. 반드시 강력한 비밀번호로 교체할 것.
# 부트스트랩을 끄려면 SEED_ADMIN_PASSWORD 를 비워 둔다.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=__SECRET__
